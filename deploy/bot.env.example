# Скопируйте в bot.env и заполните. bot.env НЕ коммитьте: в нём секрет вебхука.

# --- Обязательно ---
# URL вебхука: настройки канала Lolka -> Интеграции -> Вебхуки
LOLKA_WEBHOOK_URL=https://lolka.app/api/webhooks/000000000000/ВАШ_ТОКЕН

# Кого отслеживать (нужно хотя бы одно из двух):
# id клана (из ответа /players -> clan.id)
POKEBONK_CLAN_ID=a93a1cc4-c624-462f-addf-3c61d51286c2
# и/или ники через запятую — например, друзья из других кланов
POKEBONK_PLAYERS=

# --- Дополнительные каналы (каждый — отдельный вебхук в своём канале Lolka) ---
# Живое табло клана: одно сообщение, которое бот редактирует
#LOLKA_BOARD_WEBHOOK_URL=https://lolka.app/api/webhooks/000000000000/ТОКЕН
# Как часто обновлять табло, сек
#BOARD_UPDATE_SECS=300
# Новости и патчноуты игры
#LOLKA_NEWS_WEBHOOK_URL=https://lolka.app/api/webhooks/000000000000/ТОКЕН
# Как часто проверять новости, сек
#NEWS_POLL_SECS=1800

# --- Итоги дня ---
# Во сколько публиковать (ЧЧ:ММ) или off
#DIGEST_TIME=23:00
# Часовой пояс: Europe/Moscow, Europe/Warsaw, Europe/Kyiv, UTC, +03:00 …
#TIMEZONE=Europe/Moscow
# Свой канал для итогов (по умолчанию — основной)
#LOLKA_DIGEST_WEBHOOK_URL=

# --- Необязательно ---
# Имя бота в канале (иначе — имя вебхука)
#WEBHOOK_USERNAME=Pokebonk
# Как часто опрашивать клан, сек (новые забеги видны с этой задержкой)
#CLAN_POLL_SECS=60
# Как часто проверять каждого игрока целиком, сек (ловит нерейтинговые забеги)
#PLAYERS_POLL_SECS=600
# Как часто проверять сезон и объявления, сек (0 — выключить)
#SEASON_POLL_SECS=900
# За сколько часов до конца сезона напомнить (0 — не напоминать)
#SEASON_REMIND_HOURS=24
# Сборка в карточке забега: off | wins | long (победы и забеги от 5 мин) | all
#BUILD_DETAILS=long
# Картинка покемона в карточке, {id} — номер в покедексе (пусто — без картинки)
#SPRITE_URL=https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/{id}.png
# Ссылка на профиль игрока в заголовке карточки: {id} или {name}
#PLAYER_URL=
# 1 — не отправлять в Lolka, только печатать сообщения в лог
#DRY_RUN=0
# error | warn | info | debug
#LOG_LEVEL=info
